+++ b/firebase/functions/verify.js
@@ -0,0 +1,147 @@
+/* Staff-sent email verification — the decisions, kept pure so they can be unit-tested
+ * (tests/verify.test.js). index.js does the I/O: Auth lookups, the send, the audit row.
+ *
+ * Why it exists: an email/password sign-up gets one verification mail, at sign-up. If it
+ * was missed — spam folder, an expired link, a mistyped inbox fixed later — nothing sent
+ * another unless the person found the resend button themselves. Staff → Accounts showed
+ * "unverified" against the account and offered no way to act on it.
+ *
+ * THE MARKER. One document per address, auth_emails/verify_<sha256>, records the last
+ * verification mail that actually went (`at`) and any staff send in flight
+ * (`pendingUntil`). deliverAuthEmail stamps `at` after every successful verify send — the
+ * person's own resends included — so "was this address sent one recently?" is one keyed
+ * read, not a scan of the send log (which is never pruned and can't be read in time order
+ * without a composite index).
+ */
+
+/** Most accounts one call will process. */
+const VERIFY_BATCH_MAX = 25;
+
+/** Gap between two sends from one call: one a second, so a staff run uses half of
+ *  Resend's default 2-a-second limit and people's own verify/reset mails still get through. */
+const VERIFY_PACE_MS = 1000;
+
+/** A verification mail to the same address within this window is not repeated. */
+const VERIFY_RESEND_GAP_MS = 24 * 3600 * 1000;
+
+/** How long a staff send holds an address while it is being sent. Long enough to cover a
+ *  send, short enough that an instance killed mid-send doesn't lock the address for a day. */
+const VERIFY_LEASE_MS = 3 * 60 * 1000;
+
+/** Stop taking new accounts once a call has run this long, and hand the rest back. Keeps
+ *  every call well inside the 120 s function timeout and the console's own wait. */
+const VERIFY_CALL_BUDGET_MS = 55 * 1000;
+
+/** One bulk send at a time across all admins and tabs, so runs can't stack up against
+ *  the provider's rate limit. Expires by itself if an instance dies holding it. */
+const VERIFY_RUN_LEASE_MS = 90 * 1000;
+
+/** Per-account outcomes. Only `sent`, `failed` and `unknown` involve a send attempt. */
+const VERIFY_OUTCOMES = ["sent", "failed", "unknown", "already_verified", "no_email", "disabled",
+  "new_account", "recently_sent", "in_progress", "not_found"];
+
+/**
+ * The uids to process: trimmed, de-duplicated, non-empty. Throws a plain Error with a
+ * message fit for the caller when the input is unusable.
+ * @param {*} raw
+ * @return {string[]}
+ */
+function parseUidBatch(raw) {
+  if (!Array.isArray(raw)) throw new Error("Choose at least one account.");
+  const uids = [...new Set(raw.map((u) => String(u == null ? "" : u).trim()).filter(Boolean))];
+  if (!uids.length) throw new Error("Choose at least one account.");
+  if (uids.length > VERIFY_BATCH_MAX) throw new Error(`At most ${VERIFY_BATCH_MAX} accounts per request.`);
+  return uids;
+}
+
+/**
+ * Why an Auth user should NOT be sent a verification mail, or null when they should.
+ * Decided from the Auth record itself — never from what the console believed — and only
+ * ever about the address ON that record, so this can't be pointed at another inbox.
+ *
+ * `new_account`: every sign-up path sends a verification mail at creation, and when the
+ * branded send fails the apps fall back to Firebase's own, which leaves no marker. So an
+ * account created inside the window is treated as already sent one.
+ * @param {{email?: string, emailVerified?: boolean, disabled?: boolean,
+ *          metadata?: {creationTime?: string}}} user
+ * @param {number} now
+ * @return {null|"no_email"|"already_verified"|"disabled"|"new_account"}
+ */
+function verifySkipReason(user, now) {
+  const u = user || {};
+  if (!String(u.email || "").trim()) return "no_email";
+  if (u.emailVerified === true) return "already_verified";
+  if (u.disabled === true) return "disabled";
+  const created = Date.parse((u.metadata && u.metadata.creationTime) || "");
+  if (Number.isFinite(created) && now - created < VERIFY_RESEND_GAP_MS) return "new_account";
+  return null;
+}
+
+/**
+ * Read an address's marker ({at, pendingUntil}, epoch ms or null) and say whether a staff
+ * send may go now. `recently_sent` only ever comes from a send that WENT (`at`); a staff
+ * send still in flight — or one whose instance died — is `in_progress`, which expires on
+ * its own, so nobody is told an email went when it didn't.
+ * @param {{at?: number|null, pendingUntil?: number|null}|null} marker
+ * @param {number} now
+ * @return {null|"recently_sent"|"in_progress"}
+ */
+function markerDecision(marker, now) {
+  const m = marker || {};
+  const at = Number(m.at) || 0;
+  if (at && now - at < VERIFY_RESEND_GAP_MS) return "recently_sent";
+  const pending = Number(m.pendingUntil) || 0;
+  if (pending > now) return "in_progress";
+  return null;
+}
+
+/**
+ * Was a verification mail sent to this address recently, judged from send-log rows
+ * ({kind, at} with `at` in epoch ms)? Rows of other kinds (a password reset) don't count.
+ * Secondary to the marker: it covers sends logged before the marker existed.
+ * @param {Array<{kind?: string, at?: number}>} rows
+ * @param {number} now
+ * @param {number} [windowMs]
+ * @return {boolean}
+ */
+function sentRecently(rows, now, windowMs = VERIFY_RESEND_GAP_MS) {
+  const cutoff = now - windowMs;
+  return (rows || []).some((r) => r && r.kind === "verify" && Number(r.at) > cutoff);
+}
+
+/**
+ * Did a failed send definitely NOT go out? True for anything that failed before or at the
+ * provider's door: an HTTP refusal from Resend ("resend 4xx/5xx: …", from sendViaResend),
+ * a missing API key, or an Auth error while generating the link. Anything else — a dropped
+ * connection, a timeout waiting for the answer — may have been delivered, and is treated
+ * as `unknown` so it is never re-sent inside the window.
+ * @param {*} err
+ * @return {boolean}
+ */
+function definitelyNotSent(err) {
+  const msg = String((err && err.message) || "");
+  const code = String((err && err.code) || "");
+  return /^resend \d{3}\b/.test(msg) || /RESEND_API_KEY is not set/.test(msg) || code.startsWith("auth/");
+}
+
+/** Totals for the console. */
+function summarise(results) {
+  const out = {sent: 0, failed: 0, unknown: 0, skipped: 0};
+  (results || []).forEach((r) => {
+    if (r.outcome === "sent") out.sent++;
+    else if (r.outcome === "failed") out.failed++;
+    else if (r.outcome === "unknown") out.unknown++;
+    else out.skipped++;
+  });
+  return out;
+}
+
+/** A Resend rate-limit refusal — worth one retry after a pause; anything else is not. */
+const isRateLimited = (err) => /^resend 429\b/.test(String((err && err.message) || ""));
+
+module.exports = {
+  VERIFY_BATCH_MAX, VERIFY_PACE_MS, VERIFY_RESEND_GAP_MS, VERIFY_LEASE_MS,
+  VERIFY_CALL_BUDGET_MS, VERIFY_RUN_LEASE_MS, VERIFY_OUTCOMES,
+  parseUidBatch, verifySkipReason, markerDecision, sentRecently, definitelyNotSent,
+  summarise, isRateLimited,
+};
