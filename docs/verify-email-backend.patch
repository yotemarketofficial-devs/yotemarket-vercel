+ *  deliverAuthEmail, above, can use it. */
+function verifyMarkerRef(email) {
+  return db.collection("auth_emails").doc(`verify_${emailKey(email)}`);
+}
+
+/** Lease the address for one staff send. A transaction, so two admins can't both send.
+ *  Returns null when it may go, or the reason it may not (recently_sent | in_progress). */
+async function leaseVerifySend(email, byUid) {
+  const ref = verifyMarkerRef(email);
+  return db.runTransaction(async (tx) => {
+    const snap = await tx.get(ref);
+    const d = snap.exists ? snap.data() : {};
+    const now = Date.now();
+    const why = verifyLib.markerDecision({at: msOf(d.at) || 0, pendingUntil: Number(d.pendingUntil) || 0}, now);
+    if (why) return why;
+    tx.set(ref, {kind: "verify-marker", pendingUntil: now + verifyLib.VERIFY_LEASE_MS, by: byUid || null}, {merge: true});
+    return null;
+  });
