+/**
+ * verify.test.js — the decisions behind staff-sent email verification.
+ *
+ * Pure tests, no emulator. The cases are the ones that would email somebody who should
+ * not get it (verified, disabled, no address, new, already mailed today, a send already
+ * in flight), report a send that didn't happen, or re-send one that might have.
+ */
+import {describe, it, expect} from "vitest";
+import {createRequire} from "module";
+
+const require = createRequire(import.meta.url);
+const {
+  VERIFY_BATCH_MAX, VERIFY_RESEND_GAP_MS, VERIFY_LEASE_MS,
+  parseUidBatch, verifySkipReason, markerDecision, sentRecently, definitelyNotSent,
+  summarise, isRateLimited,
+} = require("../functions/verify.js");
+
+const NOW = Date.UTC(2026, 9, 6, 12);
+const DAY = 24 * 3600e3;
+const user = (over = {}) => ({
+  email: "a@example.com", emailVerified: false, disabled: false,
+  metadata: {creationTime: new Date(NOW - 30 * DAY).toUTCString()}, ...over,
+});
+
+describe("parseUidBatch", () => {
+  it("trims, drops blanks and de-duplicates", () => {
+    expect(parseUidBatch([" a ", "b", "a", "", null, "b"])).toEqual(["a", "b"]);
+  });
+
+  it("refuses anything that isn't a non-empty list", () => {
+    for (const bad of [undefined, null, "a", {}, [], ["", "  "]]) {
+      expect(() => parseUidBatch(bad), JSON.stringify(bad)).toThrow(/at least one/);
+    }
+  });
+
+  it("caps a single request", () => {
+    const max = Array.from({length: VERIFY_BATCH_MAX}, (_, i) => `u${i}`);
+    expect(parseUidBatch(max)).toHaveLength(VERIFY_BATCH_MAX);
+    expect(() => parseUidBatch([...max, "one-more"])).toThrow(/At most/);
+  });
+});
+
+describe("verifySkipReason — decided from the Auth record", () => {
+  it("sends to an unverified, enabled, established account with an address", () => {
+    expect(verifySkipReason(user(), NOW)).toBeNull();
+  });
+
+  it("never sends without an address (phone sign-in)", () => {
+    expect(verifySkipReason(user({email: ""}), NOW)).toBe("no_email");
+    expect(verifySkipReason(user({email: undefined}), NOW)).toBe("no_email");
+    expect(verifySkipReason(null, NOW)).toBe("no_email");
+  });
+
+  it("never re-sends to a verified account, even if the console thought otherwise", () => {
+    expect(verifySkipReason(user({emailVerified: true}), NOW)).toBe("already_verified");
+  });
+
+  it("never mails a disabled account", () => {
+    expect(verifySkipReason(user({disabled: true}), NOW)).toBe("disabled");
+  });
+
+  it("leaves an account created in the last day alone — its sign-up mail is still fresh", () => {
+    // The apps fall back to Firebase's own verification mail when the branded one fails,
+    // and that leaves no marker, so creation time is the only evidence there is.
+    expect(verifySkipReason(user({metadata: {creationTime: new Date(NOW - 3600e3).toUTCString()}}), NOW)).toBe("new_account");
+    expect(verifySkipReason(user({metadata: {creationTime: new Date(NOW - DAY - 1000).toUTCString()}}), NOW)).toBeNull();
+  });
+
+  it("does not trip on a missing or unreadable creation time", () => {
+    expect(verifySkipReason(user({metadata: {}}), NOW)).toBeNull();
+    expect(verifySkipReason(user({metadata: {creationTime: "nope"}}), NOW)).toBeNull();
+    expect(verifySkipReason(user({metadata: undefined}), NOW)).toBeNull();
+  });
+});
+
+describe("markerDecision — the per-address marker", () => {
+  it("lets a send go when nothing is recorded", () => {
+    expect(markerDecision(null, NOW)).toBeNull();
+    expect(markerDecision({}, NOW)).toBeNull();
+  });
+
+  it("says recently_sent only for a mail that WENT inside the window", () => {
+    expect(markerDecision({at: NOW - 3600e3}, NOW)).toBe("recently_sent");
+    expect(markerDecision({at: NOW - VERIFY_RESEND_GAP_MS - 1}, NOW)).toBeNull();
+  });
+
+  it("calls a staff send still in flight in_progress — never 'sent'", () => {
+    expect(markerDecision({pendingUntil: NOW + 1000}, NOW)).toBe("in_progress");
+  });
+
+  it("lets an abandoned lease expire instead of locking the address for a day", () => {
+    // An instance killed mid-send never clears its lease; it must not read as a send.
+    expect(markerDecision({pendingUntil: NOW - 1}, NOW)).toBeNull();
+    expect(VERIFY_LEASE_MS).toBeLessThan(10 * 60 * 1000);
+  });
+
+  it("prefers 'sent' to 'in progress' when both are recorded", () => {
+    expect(markerDecision({at: NOW - 60e3, pendingUntil: NOW + 60e3}, NOW)).toBe("recently_sent");
+  });
+});
+
+describe("sentRecently — the send log, for sends from before the marker", () => {
+  it("counts a verification mail inside the window", () => {
+    expect(sentRecently([{kind: "verify", at: NOW - 3600e3}], NOW)).toBe(true);
+  });
+
+  it("ignores one outside the window, and other kinds of mail", () => {
+    expect(sentRecently([{kind: "verify", at: NOW - VERIFY_RESEND_GAP_MS - 1}], NOW)).toBe(false);
+    expect(sentRecently([{kind: "reset", at: NOW - 60e3}], NOW)).toBe(false);
+  });
+
+  it("treats a row with no time as not recent rather than blocking forever", () => {
+    expect(sentRecently([{kind: "verify"}, {kind: "verify", at: null}], NOW)).toBe(false);
+    expect(sentRecently(null, NOW)).toBe(false);
+  });
+});
+
+describe("definitelyNotSent — failed, or maybe delivered?", () => {
+  it("is sure for a refusal from Resend, a missing key, or a link that couldn't be made", () => {
+    expect(definitelyNotSent(new Error("resend 403: domain is not verified"))).toBe(true);
+    expect(definitelyNotSent(new Error("resend 429: Too many requests"))).toBe(true);
+    expect(definitelyNotSent(new Error("RESEND_API_KEY is not set"))).toBe(true);
+    expect(definitelyNotSent(Object.assign(new Error("x"), {code: "auth/user-not-found"}))).toBe(true);
+  });
+
+  it("is NOT sure for a dropped connection or a timeout — the mail may have gone", () => {
+    expect(definitelyNotSent(new TypeError("fetch failed"))).toBe(false);
+    expect(definitelyNotSent(Object.assign(new Error("This operation was aborted"), {name: "AbortError"}))).toBe(false);
+    expect(definitelyNotSent(null)).toBe(false);
+  });
+});
+
+describe("summarise", () => {
+  it("separates sent, failed, unknown and deliberately skipped", () => {
+    expect(summarise([
+      {outcome: "sent"}, {outcome: "sent"}, {outcome: "failed"}, {outcome: "unknown"},
+      {outcome: "recently_sent"}, {outcome: "in_progress"}, {outcome: "new_account"}, {outcome: "no_email"},
+    ])).toEqual({sent: 2, failed: 1, unknown: 1, skipped: 4});
+  });
+});
+
+describe("isRateLimited", () => {
+  it("recognises Resend's 429 as sendViaResend reports it", () => {
+    expect(isRateLimited(new Error("resend 429: Too many requests"))).toBe(true);
+  });
+
+  it("does not retry other failures", () => {
+    expect(isRateLimited(new Error("resend 403: domain is not verified"))).toBe(false);
+    expect(isRateLimited(new Error("resend 4290 weird"))).toBe(false);
+    expect(isRateLimited(new Error("upstream said resend 429"))).toBe(false);
+    expect(isRateLimited(null)).toBe(false);
+  });
+});
