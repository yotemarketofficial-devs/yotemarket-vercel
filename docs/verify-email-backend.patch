+    async (request) => {
+      await assertAdmin(request);
+      let uids;
+      try { uids = verifyLib.parseUidBatch((request.data || {}).uids); } catch (e) {
+        throw new HttpsError("invalid-argument", e.message);
+      }
+      const releaseRun = await leaseVerifyRun(request.auth.uid);
+      if (!releaseRun) {
+        throw new HttpsError("aborted", "Another admin is sending verification emails right now. Try again in a minute.");
+      }
+
+      const started = Date.now();
+      const results = [];
+      const notAttempted = [];
+      let lastSend = 0;
+      try {
+        for (let i = 0; i < uids.length; i++) {
+          const uid = uids[i];
+          if (Date.now() - started > verifyLib.VERIFY_CALL_BUDGET_MS) { notAttempted.push(...uids.slice(i)); break; }
+
+          let user;
+          try { user = await admin.auth().getUser(uid); } catch (e) {
+            results.push(e && e.code === "auth/user-not-found" ?
+              {uid, outcome: "not_found"} :
+              {uid, outcome: "failed", error: String((e && (e.code || e.message)) || "lookup failed").slice(0, 140)});
+            continue;
+          }
+          const skip = verifyLib.verifySkipReason(user, Date.now());
+          if (skip) { results.push({uid, outcome: skip}); continue; }
+          const email = user.email;
+
+          // Sends logged before the marker existed. Secondary — the marker is the rule.
+          const logSnap = await db.collection("auth_emails").where("email", "==", email).limit(25).get().catch(() => null);
+          const rows = logSnap ? logSnap.docs.map((d) => ({kind: d.data().kind, at: msOf(d.data().createdAt)})) : [];
+          if (verifyLib.sentRecently(rows, Date.now())) { results.push({uid, outcome: "recently_sent"}); continue; }
+
+          let held;
+          try { held = await leaseVerifySend(email, request.auth.uid); } catch (e) {
+            results.push({uid, outcome: "failed", error: "could not record the send — try again"});
+            continue;
+          }
+          if (held) { results.push({uid, outcome: held}); continue; }
+
+          const wait = lastSend + verifyLib.VERIFY_PACE_MS - Date.now();
+          if (wait > 0) await pause(wait);
+          try {
+            try { await deliverAuthEmail("verify", email, user.displayName || null); } catch (e) {
+              if (!verifyLib.isRateLimited(e)) throw e;
+              await pause(1100);
+              await deliverAuthEmail("verify", email, user.displayName || null);
+            }
+            // deliverAuthEmail stamped the marker's `at`. The log row is for the
+            // self-service hourly throttle, and names who sent it.
+            await db.collection("auth_emails").add({email, kind: "verify", by: request.auth.uid, createdAt: FV.serverTimestamp()}).catch(() => null);
+            results.push({uid, outcome: "sent"});
+          } catch (e) {
+            logger.warn("[email] staff verify send failed", {uid, msg: e && e.message});
+            const error = String((e && e.message) || "send failed").slice(0, 140);
+            if (verifyLib.definitelyNotSent(e)) {
+              // Refused at the door: free the address so a retry isn't blocked.
+              await verifyMarkerRef(email).set({pendingUntil: null}, {merge: true}).catch(() => {});
+              results.push({uid, outcome: "failed", error});
+            } else {
+              // It may have gone. Count it as sent for the window so nobody gets two.
+              await verifyMarkerRef(email).set({at: FV.serverTimestamp(), pendingUntil: null}, {merge: true}).catch(() => {});
+              results.push({uid, outcome: "unknown", error});
+            }
+          } finally {
+            lastSend = Date.now();
+          }
+        }
+      } finally {
+        await releaseRun();
+      }
+
+      const totals = verifyLib.summarise(results);
+      const sentUids = results.filter((r) => r.outcome === "sent").map((r) => r.uid);
+      await logAudit(request, "user.verify_email",
+          {type: "user", id: uids.length === 1 ? uids[0] : "bulk", label: uids.length === 1 ? uids[0] : `${uids.length} accounts`},
+          {...totals, sentUids, notAttempted: notAttempted.length});
+      return {results, ...totals, notAttempted};
+    });
