+/** One bulk send at a time, across admins and tabs. Returns a release function, or null
+ *  if another run holds it. Expires on its own if an instance dies holding it. */
+async function leaseVerifyRun(byUid) {
+  const ref = db.collection("auth_emails").doc("verify_run");
+  const token = `${byUid}:${Date.now()}:${Math.random().toString(36).slice(2, 8)}`;
+  const got = await db.runTransaction(async (tx) => {
+    const snap = await tx.get(ref);
+    const until = snap.exists ? Number(snap.data().until) || 0 : 0;
+    if (until > Date.now()) return false;
+    tx.set(ref, {kind: "verify-run", until: Date.now() + verifyLib.VERIFY_RUN_LEASE_MS, token, by: byUid || null});
+    return true;
+  });
+  if (!got) return null;
+  return () => db.runTransaction(async (tx) => {
+    const snap = await tx.get(ref);
+    if (snap.exists && snap.data().token === token) tx.delete(ref);
+  }).catch(() => {});
+}
+
+/**
