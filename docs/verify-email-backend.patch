+const verifyLib = require("./verify.js");
+const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+const emailKey = (email) => require("crypto").createHash("sha256").update(String(email).toLowerCase()).digest("hex").slice(0, 32);
