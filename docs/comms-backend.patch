+/* renderMessageEmail — a person-to-person message from the team (outreach, or a reply
+ * to a support request). It replaced agents emailing from their own mail apps, so the
+ * cases are: the whole message is in the email, a reply can be matched to its ticket,
+ * and staff-typed text can never become markup. */
+describe("renderMessageEmail", () => {
+  const THREAD = "https://www.yotemarket.co.ke/help?thread=abc&x=1#requests";
+  const base = {subject: "Your payout", message: "Sent to your M-Pesa.\nCheck it arrived.", ref: "YM-7F3K9Q"};
+
+  it("puts the reference in the subject so a reply can be matched to the ticket", () => {
+    expect(renderMessageEmail(base).subject).toBe("Your payout [YM-7F3K9Q]");
+    expect(renderMessageEmail({...base, ref: undefined}).subject).toBe("Your payout");
+  });
+
+  it("carries the whole message in both parts, keeping the author's line breaks", () => {
+    const {html, text} = renderMessageEmail(base);
+    expect(text).toContain("Sent to your M-Pesa.\nCheck it arrived.");
+    expect(html).toContain("Sent to your M-Pesa.<br />Check it arrived.");
+  });
+
+  it("escapes what staff typed — a message is text, never markup", () => {
+    const {html} = renderMessageEmail({...base, subject: "<b>hi</b>", message: '<img src=x onerror="alert(1)">', name: "<i>A</i>"});
+    expect(html).not.toContain("<img src=x");
+    expect(html).not.toContain("<b>hi</b>");
+    expect(html).toContain("&lt;img src=x");
+    expect(html).toContain("&lt;i&gt;A&lt;/i&gt;");
+  });
+
+  it("links to the thread in both parts when there is one", () => {
+    const {html, text} = renderMessageEmail({...base, ctaUrl: THREAD, ctaLabel: "Read and reply"});
+    expect(html).toContain(THREAD.replace(/&/g, "&amp;"));
+    expect(text).toContain(`Read and reply: ${THREAD}`);
+  });
+
+  it("renders no button at all without a thread link (someone who wrote in signed out)", () => {
+    const {html} = renderMessageEmail(base);
+    expect(html).not.toMatch(/<a href="[^"]*"[^>]*font-weight:700/);
+  });
+
+  it("refuses a non-https button link", () => {
+    for (const bad of ["http://evil.example", "javascript:alert(1)", "//evil.example"]) {
+      expect(() => renderMessageEmail({...base, ctaUrl: bad}), bad).toThrow(/https/);
+    }
+  });
+
+  it("says a reply reaches support only when there is somewhere for it to go", () => {
+    expect(renderMessageEmail({...base, canReply: true}).text).toMatch(/reply to this email/i);
+    expect(renderMessageEmail({...base, canReply: false}).text).not.toMatch(/reply to this email/i);
+  });
+
+  it("refuses to send an empty message", () => {
